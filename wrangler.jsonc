{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "animcp",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
